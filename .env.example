# --- LLM providers ---
OPENAI_API_KEY=
GEMINI_API_KEY=

# --- Catalog ingest ---
# Estimates dimensions a merchant feed leaves out, from the ones it supplies.
# Falls back to an offline lookup table with no OPENAI_API_KEY set; set to 0 to
# require merchants to supply every measurement themselves.
DIMENSION_ESTIMATE=1
DIMENSION_MODEL=gpt-4o-mini

# Hosts the server may fetch product images from, for reverse image search.
# Merchant-supplied image_urls are untrusted input, so this allowlist is what
# stops a catalog entry making the server fetch an arbitrary URL.
IMAGE_FETCH_ALLOWED_HOSTS=www.ikea.com,ikea.com,res.cloudinary.com,hipvan-images-production.imgix.net

# --- Visa Developer Platform (sandbox) ---
# Off by default. The app runs fully simulated without any of this.
VISA_LIVE=false

# Mutual TLS. Paths, not contents - never inline a private key here.
# The client certificate is issued by VDP after you submit a CSR
# (one is generated at secrets/visa_request.csr).
VISA_CERT_PATH=./secrets/visa_cert.pem
VISA_KEY_PATH=./secrets/visa_private_key.pem
VISA_CA_PATH=./secrets/visa_ca_bundle.pem

# HTTP Basic, required IN ADDITION to the certificates.
VISA_USER_ID=
VISA_PASSWORD=

# Click to Pay / VDES x-pay-token signing.
# Also accepted as VISA_X_PAY_TOKEN (the VDP dashboard tab name).
VISA_API_KEY=
VISA_SHARED_SECRET=

# --- Visa Direct payouts (Message Level Encryption) ---
# Visa Direct will not accept a plaintext body even over mTLS. Register the
# public key at secrets/visa_mle_public.pem in your VDP project; VDP returns a
# key ID and Visa's own MLE certificate.
VISA_MLE_KEY_ID=
VISA_MLE_PRIVATE_KEY_PATH=./secrets/visa_mle_private.pem
VISA_MLE_SERVER_CERT_PATH=./secrets/visa_mle_server.pem

# Issued with a Visa Direct agreement; specific to the originating entity.
VISA_DIRECT_ACQUIRING_BIN=
VISA_DIRECT_ACQUIRER_COUNTRY=702
VISA_DIRECT_SENDER_ACCOUNT=
